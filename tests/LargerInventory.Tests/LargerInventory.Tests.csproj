<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立的回归测试（控制台程序，无第三方测试框架依赖）。
    需要本机安装 tModLoader；如安装路径不同，请通过 /p:TmlDir=路径 指定。
    运行：在仓库根目录执行 dotnet run 指向本工程（tests/LargerInventory.Tests）。
    注意：测试只覆盖不依赖游戏运行时的逻辑；页文件与 Item 序列化需游戏内验证。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TmlDir Condition="'$(TmlDir)' == ''">D:\Software\Steam\steamapps\common\tModLoader</TmlDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LargerInventory">
      <HintPath>..\..\bin\Debug\net8.0\LargerInventory.dll</HintPath>
    </Reference>
    <Reference Include="tModLoader">
      <HintPath>$(TmlDir)\tModLoader.dll</HintPath>
    </Reference>
    <Reference Include="TerrariaHooks">
      <HintPath>$(TmlDir)\Libraries\TerrariaHooks\0.0.0.0\TerrariaHooks.dll</HintPath>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(TmlDir)\Libraries\FNA\1.0.0\FNA.dll</HintPath>
    </Reference>
    <Reference Include="ReLogic">
      <HintPath>$(TmlDir)\Libraries\ReLogic\1.0.0\ReLogic.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(TmlDir)\Libraries\log4net\2.0.8.0\log4net.dll</HintPath>
    </Reference>
    <!-- store.meta 使用压缩 TagIO，需要 DotNetZip -->
    <Reference Include="DotNetZip">
      <HintPath>$(TmlDir)\Libraries\dotnetzip\1.16.0\lib\netstandard2.0\DotNetZip.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
