<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
	  <AssemblyName>LargerInventory</AssemblyName>
	  <RootNamespace>LargerInventory</RootNamespace>
	</PropertyGroup>

	<!-- 独立测试工程不参与模组编译 -->
	<ItemGroup>
	  <Compile Remove="tests\**" />
	  <EmbeddedResource Remove="tests\**" />
	  <None Remove="tests\**" />
	</ItemGroup>

	<!-- 文档和示例源码由独立工程验证，buildIgnore 也会排除这两个目录。 -->
	<ItemGroup>
	  <Compile Remove="docs\**\*.cs;example\**\*.cs" />
	</ItemGroup>

	<!-- References -->

</Project>
